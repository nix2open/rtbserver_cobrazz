[Unit]
Description=Bid price UI (adbe05:3091)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/bid-price-ui/backend
EnvironmentFile=-/opt/bid-price-ui/config.env
ExecStart=/usr/bin/python3.12 -m uvicorn app.main:app --host ${BIND_HOST:-0.0.0.0} --port ${BIND_PORT:-3091}
Restart=on-failure
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
